# Visual Studio 2015 user specific files
Gore/.vs/

# Compiled Object files
Gore/*.slo
Gore/*.lo
Gore/*.o
Gore/*.obj

# Precompiled Headers
Gore/*.gch
Gore/*.pch

# Compiled Dynamic libraries
Gore/*.so
Gore/*.dylib
Gore/*.dll

# Fortran module files
Gore/*.mod

# Compiled Static libra1ries
Gore/*.lai
Gore/*.la
Gore/*.a
Gore/*.lib

# Executables
Gore/*.exe
Gore/*.out
Gore/*.app
Gore/*.ipa

# These project files can be generated by the engine
Gore/*.xcodeproj
Gore/*.xcworkspace
Gore/*.sln
Gore/*.suo
Gore/*.opensdf
Gore/*.sdf
Gore/*.VC.db
Gore/*.VC.opendb
Gore/.vsconfig

# Precompiled Assets
Gore/SourceArt/**/*.png
Gore/SourceArt/**/*.tga

# Binary Files
Gore/Binaries/*
Gore/Plugins/**/Binaries/*

# Builds
Gore/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Gore/Build/*/
Gore/Build/*/**
!Gore/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Gore/Build/**/*.ico

# Built data for maps
Gore/*_BuiltData.uasset

# Configuration files generated by the Editor
Gore/Saved/*

# Compiled source files for the engine to use
Gore/Intermediate/*
Gore/Plugins/**/Intermediate/*

# Cache files for the editor to use
Gore/DerivedDataCache/*
